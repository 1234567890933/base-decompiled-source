<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/content_view_big"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rel_lyt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_micro"
        android:layout_marginStart="@dimen/padding_micro">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_toStartOf="@+id/chronometer_frame">
            <TextView
                android:textAppearance="@style/PushTitle"
                android:ellipsize="end"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:maxLines="1"/>
            <TextView
                android:textAppearance="@style/PushMessageMultiLine"
                android:ellipsize="end"
                android:id="@+id/msg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:maxLines="4"
                android:layout_below="@+id/title"
                android:layout_alignStart="@+id/title"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/chronometer_frame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_alignParentEnd="true">
            <ImageView
                android:id="@+id/chronometer_bg"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitXY"
                android:layout_alignTop="@+id/chronometer"
                android:layout_alignBottom="@+id/chronometer"
                android:layout_alignStart="@+id/chronometer"
                android:layout_alignEnd="@+id/chronometer"/>
            <Chronometer
                android:textSize="@dimen/chronometer_font_size"
                android:textColor="@color/titleColor"
                android:gravity="center"
                android:id="@+id/chronometer"
                android:background="@android:color/transparent"
                android:padding="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="center"/>
        </RelativeLayout>
    </RelativeLayout>
    <include
        android:id="@+id/big_media_configurable"
        layout="@layout/image_media_dynamic_linear"/>
</LinearLayout>
