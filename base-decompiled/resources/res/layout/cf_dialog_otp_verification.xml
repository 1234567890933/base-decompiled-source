<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_parent"
    android:background="@drawable/cf_bg_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginHorizontal="16dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/cf_black"
                android:id="@+id/tv_cf_enter_otp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/cf_otp_for_text"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f0801b9"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_cf_enter_otp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_cf_enter_otp"/>
            <com.cashfree.pg.core.api.view.CFNetworkImageView
                android:id="@+id/iv_bank_logo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="16dp"
                android:src="0x7f0801ca"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_cf_enter_otp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:id="@+id/tv_bank_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_bank_logo"
                app:layout_constraintStart_toEndOf="@+id/iv_bank_logo"
                app:layout_constraintTop_toTopOf="@+id/iv_bank_logo"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:id="@+id/tv_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/cf_otp_message"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_bank_logo"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_otp_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_message">
                <androidx.constraintlayout.widget.Group
                    android:id="@+id/group_otp_enter"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="til_otp,tv_resend, btn_submit"/>
                <androidx.constraintlayout.widget.Group
                    android:id="@+id/group_otp_auto_submit"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="card_view_auto_submit"/>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_view_auto_submit"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeColor="@color/cf_card_border_color"
                    app:strokeWidth="1dp">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/cv_submit_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cf_auto_submit_message"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/cv_timer_progress"
                            android:layout_width="160dp"
                            android:layout_height="3dp"
                            android:layout_marginTop="16dp"
                            android:indeterminate="true"
                            app:indeterminateAnimationType="contiguous"
                            app:indicatorColor="@array/progress_color"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/cv_submit_title"
                            app:trackThickness="3dp"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="14sp"
                            android:id="@+id/cv_submitting_in"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/submit_otp_in"
                            app:layout_constraintStart_toStartOf="@+id/cv_timer_progress"
                            app:layout_constraintTop_toBottomOf="@+id/cv_timer_progress"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:id="@+id/cv_dismiss_timer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:layout_marginStart="6dp"
                            app:layout_constraintStart_toEndOf="@+id/cv_submitting_in"
                            app:layout_constraintTop_toBottomOf="@+id/cv_timer_progress"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="16sp"
                            android:textColor="@color/cf_cancel_red"
                            android:id="@+id/cv_cancel_auto_submit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/cf_cancel_auto_submit"
                            app:layout_constraintEnd_toEndOf="@+id/cv_timer_progress"
                            app:layout_constraintStart_toStartOf="@+id/cv_timer_progress"
                            app:layout_constraintTop_toBottomOf="@+id/cv_dismiss_timer"/>
                        <androidx.constraintlayout.widget.Group
                            android:id="@+id/group_otp_auto_submit_timer_info"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:constraint_referenced_ids="cv_cancel_auto_submit,cv_dismiss_timer, cv_submitting_in"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_otp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:endIconMode="clear_text"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
                    <com.google.android.material.textfield.TextInputEditText
                        android:textSize="12sp"
                        android:id="@+id/tie_otp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/cf_enter_otp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:maxLength="6"
                        android:inputType="number"
                        android:imeOptions="actionDone"/>
                </com.google.android.material.textfield.TextInputLayout>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textColor="@color/color_cta"
                    android:id="@+id/tv_resend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/cf_resent_otp"
                    app:layout_constraintEnd_toEndOf="@+id/til_otp"
                    app:layout_constraintTop_toBottomOf="@+id/til_otp"/>
                <com.google.android.material.button.MaterialButton
                    android:theme="@style/CFCoreUPIStyle"
                    android:id="@+id/btn_submit"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="32dp"
                    android:text="@string/cf_pay_proceed"
                    android:textAllCaps="false"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/til_otp"
                    style="@style/Widget.MaterialComponents.Button"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_bank_redirection"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tv_bank_redirection_info,tv_bank_redirection_text"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:gravity="center_horizontal"
                android:id="@+id/tv_bank_redirection_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="28dp"
                android:layout_marginRight="8dp"
                android:text="@string/bank_redirection_info"
                android:layout_marginHorizontal="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cl_otp_view"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:id="@+id/tv_bank_redirection_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/bank_redirection_text"
                app:drawableEndCompat="0x7f0801c9"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_bank_redirection_info"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:id="@+id/tv_cf_secured"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/cf_secured"
                android:drawablePadding="8dp"
                app:drawableEndCompat="0x7f0801de"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_bank_redirection_text"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/cf_loader"
            android:background="#30000000"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.card.MaterialCardView
                android:layout_gravity="center"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:alpha="0.2"
                app:cardBackgroundColor="#000000"
                app:cardElevation="0dp"
                app:strokeColor="@android:color/transparent"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/progress_bar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_margin="24dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f0802c3"/>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
