<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cf_bg_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/nb_app"
        android:paddingLeft="16dp"
        android:paddingTop="8dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">
        <com.cashfree.pg.core.api.view.CFNetworkImageView
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/iv_logo"
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:layout_marginTop="24dp"
            android:src="0x7f0801da"/>
        <ProgressBar
            android:layout_gravity="center_horizontal"
            android:id="@+id/pb_pv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_gravity="center_horizontal"
            android:id="@+id/ll_timer"
            android:background="@drawable/cf_ic_rounded_time_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <TextView
                android:layout_gravity="center"
                android:id="@+id/tv_time"
                android:paddingLeft="16dp"
                android:paddingTop="8dp"
                android:paddingRight="16dp"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <TextView
            android:textColor="@android:color/black"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="32dp"
            android:text="Do not close until payment is verified."
            android:layout_marginHorizontal="32dp"/>
        <com.google.android.material.button.MaterialButton
            android:textColor="@color/holo_red_dark"
            android:id="@+id/btn_cancel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="16dp"
            android:text="Cancel Payment"
            android:textAllCaps="false"
            android:layout_marginHorizontal="32dp"
            android:layout_marginVertical="16dp"
            app:strokeColor="@color/holo_red_dark"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/cf_crcl_success"
        android:background="@drawable/cf_bg_dialog_succes_rounded"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/iv_status_success_logo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="0x7f0801dc"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/cf_crcl_failure"
        android:background="@drawable/cf_bg_dialog_failure_rounded"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/iv_status_failure_logo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="0x7f0801cf"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</FrameLayout>
