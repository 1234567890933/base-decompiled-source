<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/push_base_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/custom_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/push_base_top"/>
        </FrameLayout>
        <RelativeLayout
            android:id="@+id/custom_head_container"
            android:paddingLeft="@dimen/we_push_content_margin"
            android:paddingRight="@dimen/we_push_content_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/we_push_intercontent_margin">
            <FrameLayout
                android:id="@+id/title_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/we_push_title_bottom_margin"
                android:layout_alignParentTop="true"
                android:layout_toStartOf="@+id/we_push_right_layout">
                <TextView
                    android:ellipsize="end"
                    android:id="@+id/custom_title_native"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Title"
                    android:singleLine="true"
                    style="@style/NotificationTitle"/>
                <TextView
                    android:id="@+id/custom_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Title"
                    style="@style/NotificationTitleAdaptive"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/message_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/title_layout"
                android:layout_alignStart="@+id/title_layout"
                android:layout_alignEnd="@+id/title_layout">
                <TextView
                    android:id="@+id/custom_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Message"
                    android:lineSpacingMultiplier="1.2"
                    style="@style/NotificationAdaptive"/>
                <TextView
                    android:id="@+id/custom_message_native"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Message"
                    android:lineSpacingMultiplier="1.2"
                    style="@style/Notification"/>
            </FrameLayout>
            <ProgressBar
                android:theme="@style/WeProgressBar"
                android:id="@+id/we_notification_progressBar"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/we_progress_bar_bottom_margin"
                android:indeterminate="false"
                android:layout_alignBottom="@+id/we_progress_bar_timer"
                android:layout_toStartOf="@+id/we_progress_bar_timer"
                android:layout_alignStart="@+id/message_layout"
                style="?android:attr/progressBarStyleHorizontal"/>
            <Chronometer
                android:textSize="@dimen/we_chronometer_text_size"
                android:id="@+id/we_progress_bar_timer"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/progress_bar_margin"
                android:maxLines="1"
                android:layout_below="@+id/message_layout"
                android:paddingEnd="@dimen/we_push_timer_end_padding"
                android:layout_marginStart="@dimen/we_push_right_views_left_margin"
                android:layout_alignParentEnd="true"
                android:countDown="true"
                style="@style/WeNotificationChronometerAdaptive"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/we_push_right_layout"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/we_large_icon_size_time"
                android:layout_marginStart="@dimen/we_push_right_views_left_margin"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:id="@+id/large_icon"
                    android:layout_width="@dimen/we_large_icon_size_time"
                    android:layout_height="@dimen/we_large_icon_size_time"
                    android:scaleType="centerCrop"/>
                <Chronometer
                    android:textSize="@dimen/we_chronometer_text_size"
                    android:gravity="center"
                    android:id="@+id/we_notification_timer"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:paddingEnd="@dimen/we_push_timer_end_padding"
                    android:countDown="true"
                    style="@style/WeNotificationChronometerAdaptive"/>
                <Chronometer
                    android:textSize="@dimen/we_big_timer_collapsed_text_size"
                    android:gravity="center"
                    android:id="@+id/we_notification_big_timer_collapsed"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:fontFamily="sans-serif-medium"
                    android:paddingEnd="@dimen/we_push_timer_end_padding"
                    android:countDown="true"
                    style="@style/WeNotificationChronometerAdaptive"/>
                <LinearLayout
                    android:gravity="end"
                    android:orientation="horizontal"
                    android:id="@+id/we_big_timer_collapsed"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="@dimen/we_push_timer_end_padding">
                    <TextView
                        android:textSize="@dimen/we_big_timer_collapsed_text_size"
                        android:textColor="@color/we_black"
                        android:id="@+id/we_hr_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"/>
                    <TextView
                        android:textSize="@dimen/we_big_timer_collapsed_text_size"
                        android:textColor="@color/we_black"
                        android:id="@+id/we_hr_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"/>
                    <TextView
                        android:textSize="@dimen/we_big_timer_collapsed_text_size"
                        android:textColor="@color/we_black"
                        android:id="@+id/hr_min_delimiter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/colon"
                        android:fontFamily="sans-serif-medium"/>
                    <TextView
                        android:textSize="@dimen/we_big_timer_collapsed_text_size"
                        android:textColor="@color/we_black"
                        android:id="@+id/we_min_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"/>
                    <TextView
                        android:textSize="@dimen/we_big_timer_collapsed_text_size"
                        android:textColor="@color/we_black"
                        android:id="@+id/we_min_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"/>
                    <TextView
                        android:textSize="@dimen/we_big_timer_collapsed_text_size"
                        android:textColor="@color/we_black"
                        android:id="@+id/min_sec_delimiter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/colon"
                        android:fontFamily="sans-serif-medium"/>
                    <TextView
                        android:textSize="@dimen/we_big_timer_collapsed_text_size"
                        android:textColor="@color/we_black"
                        android:id="@+id/we_sec_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"/>
                    <ViewFlipper
                        android:layout_gravity="bottom"
                        android:id="@+id/we_sec_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:inAnimation="@anim/slide_in_timer"
                        android:outAnimation="@anim/slide_out_timer"
                        android:autoStart="true"/>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
        <FrameLayout
            android:orientation="vertical"
            android:id="@+id/custom_base_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/push_base_margin_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/we_push_content_margin"/>
    </LinearLayout>
</FrameLayout>
