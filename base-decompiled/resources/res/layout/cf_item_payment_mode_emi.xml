<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">
    <RelativeLayout
        android:id="@+id/rl_emi_payment_mode"
        android:paddingTop="@dimen/cf_dimen_8"
        android:paddingBottom="@dimen/cf_dimen_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/cf_dimen_8">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:id="@+id/view_emi_ic"
            android:background="@drawable/cf_ic_rounded_bg"
            android:layout_width="@dimen/cf_dimen_42"
            android:layout_height="@dimen/cf_dimen_42"
            android:layout_marginLeft="@dimen/cf_dimen_16"
            android:layout_marginRight="@dimen/cf_dimen_16"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_marginHorizontal="@dimen/cf_dimen_16">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_emi_ic"
                android:layout_width="@dimen/cf_dimen_24"
                android:layout_height="@dimen/cf_dimen_24"
                android:layout_marginLeft="@dimen/cf_dimen_16"
                android:layout_marginRight="@dimen/cf_dimen_16"
                android:src="0x7f0801cb"
                android:layout_marginHorizontal="@dimen/cf_dimen_16"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <TextView
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:textSize="@dimen/cf_text_size_18"
            android:id="@+id/tv_emi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cf_dimen_16"
            android:layout_marginTop="@dimen/cf_dimen_16"
            android:layout_marginRight="@dimen/cf_dimen_16"
            android:text="@string/cf_title_emi"
            android:layout_centerVertical="true"
            android:textAllCaps="false"
            android:layout_toEndOf="@+id/view_emi_ic"
            android:layout_marginHorizontal="@dimen/cf_dimen_16"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_emi_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cf_dimen_16"
            android:layout_marginRight="@dimen/cf_dimen_16"
            android:src="0x7f0801ce"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:layout_marginHorizontal="@dimen/cf_dimen_16"/>
    </RelativeLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
