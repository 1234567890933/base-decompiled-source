<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/widget_card"
        android:background="@drawable/widget_card_clip"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:clipToOutline="true">
        <ImageView
            android:id="@+id/widget_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_background_rounded"
            android:scaleType="fitXY"/>
        <ImageView
            android:id="@+id/widget_overlay"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/left_column"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:paddingStart="16dp">
                <ImageView
                    android:id="@+id/headline_image"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="fitStart"
                    android:adjustViewBounds="true"
                    android:layout_marginStart="4dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/streak_container"
                    android:clipChildren="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:clipChildren="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="2dp">
                        <ImageView
                            android:id="@+id/streak_icon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_streak_active"
                            android:scaleType="fitCenter"/>
                        <ImageView
                            android:layout_gravity="end|top"
                            android:id="@+id/streak_warning_badge"
                            android:visibility="gone"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_streak_warning_badge"
                            android:importantForAccessibility="no"/>
                        <ViewFlipper
                            android:layout_gravity="end|top"
                            android:id="@+id/streak_warning_badge_pulse"
                            android:visibility="gone"
                            android:clipChildren="false"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:inAnimation="@anim/warning_badge_pulse"
                            android:flipInterval="10000"
                            android:autoStart="true"
                            android:importantForAccessibility="noHideDescendants">
                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:src="@drawable/ic_streak_warning_badge"
                                android:importantForAccessibility="no"/>
                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:src="@drawable/ic_streak_warning_badge"
                                android:importantForAccessibility="no"/>
                        </ViewFlipper>
                    </FrameLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/streak_digits_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/digit_1"
                            android:visibility="gone"
                            android:layout_width="14dp"
                            android:layout_height="26dp"
                            android:scaleType="fitCenter"/>
                        <ImageView
                            android:id="@+id/digit_2"
                            android:visibility="gone"
                            android:layout_width="14dp"
                            android:layout_height="26dp"
                            android:scaleType="fitCenter"/>
                        <ImageView
                            android:id="@+id/digit_3"
                            android:visibility="gone"
                            android:layout_width="14dp"
                            android:layout_height="26dp"
                            android:scaleType="fitCenter"/>
                        <ImageView
                            android:id="@+id/digit_4"
                            android:visibility="gone"
                            android:layout_width="14dp"
                            android:layout_height="26dp"
                            android:scaleType="fitCenter"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/streak_text_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp">
                        <ImageView
                            android:id="@+id/text_1"
                            android:visibility="gone"
                            android:layout_width="13dp"
                            android:layout_height="26dp"
                            android:scaleType="fitCenter"/>
                        <ImageView
                            android:id="@+id/text_2"
                            android:visibility="gone"
                            android:layout_width="13dp"
                            android:layout_height="26dp"
                            android:scaleType="fitCenter"/>
                        <ImageView
                            android:id="@+id/text_3"
                            android:visibility="gone"
                            android:layout_width="13dp"
                            android:layout_height="26dp"
                            android:scaleType="fitCenter"/>
                        <ImageView
                            android:id="@+id/text_4"
                            android:visibility="gone"
                            android:layout_width="13dp"
                            android:layout_height="26dp"
                            android:scaleType="fitCenter"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:id="@+id/streak_sub_msg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="6dp"
                    android:text="Fully charged"
                    android:layout_marginStart="2dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/days_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#ffffff"
                            android:gravity="center"
                            android:id="@+id/day_1_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Mo"
                            android:maxLines="1"/>
                        <FrameLayout
                            android:id="@+id/day_1_cell"
                            android:layout_width="wrap_content"
                            android:layout_height="18dp"
                            android:layout_marginTop="4dp"
                            android:paddingStart="6.5dp"
                            android:paddingEnd="6.5dp">
                            <ImageView
                                android:layout_gravity="center"
                                android:id="@+id/day_1_indicator"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/week_day_empty_light"
                                android:importantForAccessibility="no"/>
                        </FrameLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#ffffff"
                            android:gravity="center"
                            android:id="@+id/day_2_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tu"
                            android:maxLines="1"/>
                        <FrameLayout
                            android:id="@+id/day_2_cell"
                            android:layout_width="wrap_content"
                            android:layout_height="18dp"
                            android:layout_marginTop="4dp"
                            android:paddingStart="6.5dp"
                            android:paddingEnd="6.5dp">
                            <ImageView
                                android:layout_gravity="center"
                                android:id="@+id/day_2_indicator"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/week_day_empty_light"
                                android:importantForAccessibility="no"/>
                        </FrameLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#ffffff"
                            android:gravity="center"
                            android:id="@+id/day_3_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="We"
                            android:maxLines="1"/>
                        <FrameLayout
                            android:id="@+id/day_3_cell"
                            android:layout_width="wrap_content"
                            android:layout_height="18dp"
                            android:layout_marginTop="4dp"
                            android:paddingStart="6.5dp"
                            android:paddingEnd="6.5dp">
                            <ImageView
                                android:layout_gravity="center"
                                android:id="@+id/day_3_indicator"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/week_day_empty_light"
                                android:importantForAccessibility="no"/>
                        </FrameLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#ffffff"
                            android:gravity="center"
                            android:id="@+id/day_4_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Th"
                            android:maxLines="1"/>
                        <FrameLayout
                            android:id="@+id/day_4_cell"
                            android:layout_width="wrap_content"
                            android:layout_height="18dp"
                            android:layout_marginTop="4dp"
                            android:paddingStart="6.5dp"
                            android:paddingEnd="6.5dp">
                            <ImageView
                                android:layout_gravity="center"
                                android:id="@+id/day_4_indicator"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/week_day_empty_light"
                                android:importantForAccessibility="no"/>
                        </FrameLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#ffffff"
                            android:gravity="center"
                            android:id="@+id/day_5_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Fr"
                            android:maxLines="1"/>
                        <FrameLayout
                            android:id="@+id/day_5_cell"
                            android:layout_width="wrap_content"
                            android:layout_height="18dp"
                            android:layout_marginTop="4dp"
                            android:paddingStart="6.5dp"
                            android:paddingEnd="6.5dp">
                            <ImageView
                                android:layout_gravity="center"
                                android:id="@+id/day_5_indicator"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/week_day_empty_light"
                                android:importantForAccessibility="no"/>
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <ImageView
                android:id="@+id/mascot_image"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:src="@drawable/mascot_sunglasses_img"
                android:scaleType="fitCenter"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/mascot_canvas"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:scaleType="fitEnd"
            android:contentDescription="@null"/>
    </FrameLayout>
</FrameLayout>
