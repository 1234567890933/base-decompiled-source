<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/widget_card_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_gravity="center"
            android:id="@+id/widget_card"
            android:background="@drawable/widget_card_clip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToOutline="true">
            <ImageView
                android:id="@+id/aspect_ratio_setter"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/ratio_1_1"
                android:adjustViewBounds="true"/>
            <ImageView
                android:id="@+id/widget_bg"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:src="@drawable/grad_streak_reclaimed"
                android:scaleType="fitXY"
                android:layout_alignTop="@+id/aspect_ratio_setter"
                android:layout_alignBottom="@+id/aspect_ratio_setter"/>
            <ImageView
                android:id="@+id/widget_overlay"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:src="@drawable/bg_comp_streak_reclaimed"
                android:scaleType="fitXY"
                android:layout_alignTop="@+id/aspect_ratio_setter"
                android:layout_alignBottom="@+id/aspect_ratio_setter"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_alignTop="@+id/aspect_ratio_setter"
                android:layout_alignBottom="@+id/aspect_ratio_setter">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/center_content"
                    android:paddingTop="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:clipChildren="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <FrameLayout
                            android:clipChildren="false"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:id="@+id/streak_icon"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_streak_active"/>
                            <ImageView
                                android:layout_gravity="end|top"
                                android:id="@+id/streak_warning_badge"
                                android:visibility="gone"
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:src="@drawable/ic_streak_warning_badge"
                                android:importantForAccessibility="no"/>
                            <ViewFlipper
                                android:layout_gravity="end|top"
                                android:id="@+id/streak_warning_badge_pulse"
                                android:visibility="gone"
                                android:clipChildren="false"
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:inAnimation="@anim/warning_badge_pulse"
                                android:flipInterval="10000"
                                android:autoStart="true"
                                android:importantForAccessibility="noHideDescendants">
                                <ImageView
                                    android:layout_width="13dp"
                                    android:layout_height="13dp"
                                    android:src="@drawable/ic_streak_warning_badge"
                                    android:importantForAccessibility="no"/>
                                <ImageView
                                    android:layout_width="13dp"
                                    android:layout_height="13dp"
                                    android:src="@drawable/ic_streak_warning_badge"
                                    android:importantForAccessibility="no"/>
                            </ViewFlipper>
                        </FrameLayout>
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:id="@+id/streak_digits_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="0dp">
                            <ImageView
                                android:id="@+id/digit_1"
                                android:visibility="gone"
                                android:layout_width="12dp"
                                android:layout_height="23dp"
                                android:scaleType="fitCenter"/>
                            <ImageView
                                android:id="@+id/digit_2"
                                android:visibility="gone"
                                android:layout_width="12dp"
                                android:layout_height="23dp"
                                android:scaleType="fitCenter"/>
                            <ImageView
                                android:id="@+id/digit_3"
                                android:visibility="gone"
                                android:layout_width="12dp"
                                android:layout_height="23dp"
                                android:scaleType="fitCenter"/>
                            <ImageView
                                android:id="@+id/digit_4"
                                android:visibility="gone"
                                android:layout_width="12dp"
                                android:layout_height="23dp"
                                android:scaleType="fitCenter"/>
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#ffffff"
                        android:gravity="center"
                        android:id="@+id/streak_sub_msg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Ready To Start ?"
                        android:alpha="1"
                        android:textAlignment="center"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/headline_image"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"/>
                <ImageView
                    android:id="@+id/mascot_canvas"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:contentDescription="@null"/>
            </RelativeLayout>
        </RelativeLayout>
    </FrameLayout>
</FrameLayout>
