<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/big_timer_duration"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/we_big_timer_top_margin">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/we_big_timer_expanded_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/big_timer_text_size"
                android:textColor="@color/we_black"
                android:id="@+id/we_hr_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textAlignment="center"
                android:layout_marginEnd="@dimen/we_big_timer_margin"/>
            <TextView
                android:textSize="@dimen/big_timer_text_size"
                android:textColor="@color/we_black"
                android:id="@+id/we_hr_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:inAnimation="@anim/fade_in"
                android:outAnimation="@anim/fade_out"
                android:autoStart="true"
                android:fontFamily="sans-serif-medium"
                android:textAlignment="center"/>
            <TextView
                android:textSize="@dimen/big_timer_text_size"
                android:textColor="@color/we_black"
                android:id="@+id/hr_min_delimiter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/colon"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="@dimen/we_big_timer_margin"
                android:layout_marginEnd="@dimen/we_big_timer_margin"/>
            <TextView
                android:textSize="@dimen/big_timer_text_size"
                android:textColor="@color/we_black"
                android:id="@+id/we_min_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textAlignment="center"
                android:layout_marginEnd="@dimen/we_big_timer_margin"/>
            <TextView
                android:textSize="@dimen/big_timer_text_size"
                android:textColor="@color/we_black"
                android:id="@+id/we_min_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textAlignment="center"/>
            <TextView
                android:textSize="@dimen/big_timer_text_size"
                android:textColor="@color/we_black"
                android:id="@+id/min_sec_delimiter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/colon"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="@dimen/we_big_timer_margin"
                android:layout_marginEnd="@dimen/we_big_timer_margin"/>
            <TextView
                android:textSize="@dimen/big_timer_text_size"
                android:textColor="@color/we_black"
                android:id="@+id/we_sec_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:autoStart="true"
                android:fontFamily="sans-serif-medium"
                android:textAlignment="center"
                android:layout_marginEnd="@dimen/we_big_timer_margin"/>
            <ViewFlipper
                android:layout_gravity="bottom"
                android:id="@+id/we_sec_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:inAnimation="@anim/slide_in_timer"
                android:outAnimation="@anim/slide_out_timer"
                android:autoStart="true"/>
        </LinearLayout>
        <Chronometer
            android:textSize="@dimen/big_timer_text_size"
            android:gravity="center"
            android:id="@+id/we_notification_big_timer_expanded"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:countDown="true"
            style="@style/WeNotificationChronometerAdaptive"/>
        <include
            android:id="@+id/action_list"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/custom_push_action_list"/>
    </LinearLayout>
</FrameLayout>
