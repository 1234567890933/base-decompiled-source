<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">
    <RelativeLayout
        android:id="@+id/rl_card_payment_mode"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:id="@+id/view_card_ic"
            android:background="@drawable/cf_ic_rounded_bg"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_marginHorizontal="16dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_card_ic"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:src="0x7f0801cb"
                android:layout_marginHorizontal="16dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <TextView
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:textSize="18sp"
            android:id="@+id/tv_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:text="@string/cf_title_card"
            android:layout_centerVertical="true"
            android:textAllCaps="false"
            android:layout_toEndOf="@+id/view_card_ic"
            android:layout_marginHorizontal="16dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_card_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:src="0x7f0801ce"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:layout_marginHorizontal="16dp"/>
    </RelativeLayout>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/ll_card_body"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/nfc_layout"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/nfc_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="0x7f080471"
                android:layout_centerVertical="true"
                android:layout_marginStart="32dp"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textAppearance="?attr/textAppearanceHeadline6"
                android:textSize="18sp"
                android:id="@+id/nfc_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Bring the contactless card closer to the device to fill in the card information automatically."
                android:layout_centerVertical="true"
                android:textAllCaps="false"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="32dp"
                android:layout_toEndOf="@+id/nfc_icon"/>
            <TextView
                android:textAppearance="?attr/textAppearanceHeadline6"
                android:textSize="12sp"
                android:textStyle="italic"
                android:textColor="@color/design_default_color_error"
                android:id="@+id/nfc_disabled_warning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="*NFC is disabled. Please enable it to use this feature."
                android:layout_below="@+id/nfc_text"
                android:textAllCaps="false"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="32dp"
                android:layout_toEndOf="@+id/nfc_icon"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="32dp"
            android:layout_marginHorizontal="32dp">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_card_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
                <com.google.android.material.textfield.TextInputEditText
                    android:textSize="12dp"
                    android:gravity="center_vertical"
                    android:id="@+id/tie_card_holder"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:hint="Card Holder Name"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:inputType="textPersonName"
                    android:imeOptions="actionNext"
                    android:autofillHints="name"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="32dp"
            android:layout_marginHorizontal="32dp">
            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_card_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="noHideDescendants"
                    app:errorIconDrawable="@null"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
                    <com.google.android.material.textfield.TextInputEditText
                        android:textSize="12dp"
                        android:id="@+id/tie_card_number"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="Card Number"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:maxLength="19"
                        android:drawablePadding="8dp"
                        android:inputType="number"
                        android:imeOptions="actionNext"
                        android:importantForAccessibility="no"
                        android:autofillHints="creditCardNumber"
                        android:importantForAutofill="no"/>
                </com.google.android.material.textfield.TextInputLayout>
                <ImageView
                    android:layout_gravity="end"
                    android:id="@+id/iv_card_type"
                    android:visibility="visible"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:src="0x7f0801c7"
                    android:layout_marginEnd="8dp"/>
            </androidx.coordinatorlayout.widget.CoordinatorLayout>
        </LinearLayout>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="32dp"
            android:layout_marginHorizontal="32dp">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_card_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="16dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
                <com.google.android.material.textfield.TextInputEditText
                    android:textSize="12dp"
                    android:id="@+id/tie_card_date"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:hint="MM/YY"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:maxLength="5"
                    android:inputType="date"
                    android:imeOptions="actionNext"
                    android:autofillHints="creditCardExpirationMonth"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_card_cvv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:importantForAccessibility="noHideDescendants"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
                <com.google.android.material.textfield.TextInputEditText
                    android:textSize="12dp"
                    android:id="@+id/tie_card_cvv"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:hint="CVV"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:maxLength="4"
                    android:inputType="numberPassword"
                    android:imeOptions="actionDone"
                    android:importantForAccessibility="no"
                    android:autofillHints="creditCardSecurityCode"/>
            </com.google.android.material.textfield.TextInputLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <com.google.android.material.checkbox.MaterialCheckBox
            android:textAppearance="?attr/textAppearanceBody1"
            android:textSize="@dimen/cf_text_size_12"
            android:id="@+id/cb_save_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="32dp"
            android:text="@string/saved_card_securely"
            android:layout_marginHorizontal="32dp"/>
        <com.google.android.material.button.MaterialButton
            android:enabled="false"
            android:layout_gravity="center_horizontal"
            android:id="@+id/btn_card"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="10dp"
            android:text="@string/cf_pay"
            android:textAllCaps="false"
            android:layout_marginHorizontal="32dp"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:src="0x7f0801c6"
                android:layout_marginHorizontal="8dp"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:src="0x7f0801c7"
                android:layout_marginEnd="8dp"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="28dp"
                android:layout_height="20dp"
                android:src="0x7f0801c3"
                android:layout_marginEnd="8dp"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="28dp"
                android:layout_height="18dp"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:src="0x7f0801be"
                android:layout_marginHorizontal="8dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
