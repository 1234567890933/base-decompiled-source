<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <ImageView
        android:id="@+id/live_notification_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <ImageView
            android:id="@+id/live_notification_wordmark"
            android:layout_width="wrap_content"
            android:layout_height="12dp"
            android:src="@drawable/live_notification_wordmark"
            android:adjustViewBounds="true"
            android:contentDescription="Matiks"/>
        <TextView
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:id="@+id/live_notification_eyebrow"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/live_notification_streak_row"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/live_notification_streak_flame"
                android:importantForAccessibility="no"/>
            <ImageView
                android:id="@+id/live_notification_streak_image"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:layout_marginStart="3dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#cfcedc"
                android:id="@+id/live_notification_streak_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:fontFamily="@font/bebas_neue_bold"
                android:layout_marginStart="3dp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/live_notification_title_image"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:scaleType="fitStart"
            android:adjustViewBounds="true"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:layout_marginStart="10dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:id="@+id/live_notification_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:fontFamily="@font/nunito_sans_bold"
            android:layout_marginStart="10dp"/>
        <LinearLayout
            android:gravity="top"
            android:orientation="horizontal"
            android:id="@+id/live_notification_timer_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp">
            <Chronometer
                android:textSize="22sp"
                android:textColor="#ffffff"
                android:id="@+id/live_notification_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:fontFamily="@font/bebas_neue_bold"
                android:countDown="true"/>
            <ImageView
                android:id="@+id/live_notification_badge"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/live_notification_badge"
                android:importantForAccessibility="no"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
