<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/cf_bg_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="450dp">
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_nb_bank_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginVertical="16dp"
        app:endIconMode="clear_text"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <com.google.android.material.textfield.TextInputEditText
            android:textSize="12dp"
            android:id="@+id/tie_nb_bank_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/cf_search_banks"
            android:maxLines="1"
            android:singleLine="true"
            android:imeOptions="actionGo"/>
    </com.google.android.material.textfield.TextInputLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/nb_rv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="200dp"
        android:layout_weight="1"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_pay"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="16dp"
        android:text="@string/cf_pay"
        android:textAllCaps="false"
        android:layout_marginHorizontal="32dp"
        android:layout_marginVertical="16dp"/>
</androidx.appcompat.widget.LinearLayoutCompat>
