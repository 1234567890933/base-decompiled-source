<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_checkout_app"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingVertical="8dp">
    <com.cashfree.pg.core.api.view.CFNetworkImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/app_img"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/app_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        android:layout_toEndOf="@+id/app_img">
        <TextView
            android:textSize="12sp"
            android:id="@+id/app_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.8"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:ellipsize="end"
            android:id="@+id/app_name"
            android:padding="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <TextView
        android:textSize="13sp"
        android:textColor="@android:color/black"
        android:id="@+id/tv_payment_no"
        android:padding="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_centerVertical="true"
        android:alpha="0.7"
        android:layout_marginStart="16dp"
        android:layout_toEndOf="@+id/app_layout"/>
    <androidx.appcompat.widget.AppCompatRadioButton
        android:id="@+id/rb_quick_checkout"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
