<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/content_view_small"
    android:background="@android:color/transparent"
    android:paddingTop="@dimen/padding_micro"
    android:paddingBottom="@dimen/padding_micro"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/padding_horizontal"
    android:paddingEnd="@dimen/padding_horizontal">
    <include
        android:id="@+id/metadata"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        layout="@layout/metadata"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/metadata">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:layout_marginEnd="6dp">
            <TextView
                android:textAppearance="@style/PushTitle"
                android:ellipsize="end"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textAppearance="@style/PushMessage"
                android:ellipsize="end"
                android:id="@+id/msg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
        <include
            android:id="@+id/big_media_configurable"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            layout="@layout/image_media_dynamic_linear"/>
        <FrameLayout
            android:id="@+id/vertical_img_btn_frame"
            android:background="@drawable/pt_vertical_img_btn_default_bg"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp">
            <ImageView
                android:id="@+id/vertical_img_btn_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"/>
            <TextView
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/verticalImgBtnTextColor"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/vertical_img_btn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:singleLine="true"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
        </FrameLayout>
    </LinearLayout>
</RelativeLayout>
