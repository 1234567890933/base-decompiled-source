<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/content_view_big"
    android:background="@android:color/transparent"
    android:paddingLeft="@dimen/padding_horizontal"
    android:paddingTop="@dimen/padding_micro"
    android:paddingRight="@dimen/padding_horizontal"
    android:paddingBottom="@dimen/padding_micro"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/padding_horizontal"
    android:paddingVertical="@dimen/padding_micro">
    <include
        android:id="@+id/metadata"
        layout="@layout/metadata"/>
    <RelativeLayout
        android:id="@+id/vertical_img_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingEnd="@dimen/padding_horizontal">
        <include
            android:id="@+id/big_media_configurable"
            android:layout_width="120dp"
            android:layout_height="180dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            layout="@layout/image_media_dynamic_linear"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/vertical_img_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:paddingStart="12dp"
            android:layout_toEndOf="@+id/big_media_configurable">
            <TextView
                android:textAppearance="@style/PushTitle"
                android:ellipsize="end"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textAppearance="@style/PushMessageMultiLine"
                android:ellipsize="end"
                android:id="@+id/msg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="2"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/vertical_img_bottom"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/vertical_img_top"
            android:layout_alignBottom="@+id/big_media_configurable"
            android:paddingStart="12dp"
            android:layout_toEndOf="@+id/big_media_configurable">
            <TextView
                android:textAppearance="@style/PushMessageMultiLine"
                android:ellipsize="end"
                android:id="@+id/vertical_img_text1"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textAppearance="@style/PushMessageMultiLine"
                android:ellipsize="end"
                android:id="@+id/vertical_img_text2"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <FrameLayout
                android:layout_gravity="start"
                android:id="@+id/vertical_img_btn_frame"
                android:background="@drawable/pt_vertical_img_btn_default_bg"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="8dp">
                <ImageView
                    android:id="@+id/vertical_img_btn_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/verticalImgBtnTextColor"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/vertical_img_btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:singleLine="true"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>
            </FrameLayout>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
