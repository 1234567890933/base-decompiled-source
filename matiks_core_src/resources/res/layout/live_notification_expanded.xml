<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="160dp">
    <ImageView
        android:id="@+id/live_notification_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"/>
    <ImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/live_notification_art"
        android:layout_width="150dp"
        android:layout_height="140dp"
        android:scaleType="fitEnd"
        android:importantForAccessibility="no"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="20dp"
        android:paddingEnd="132dp">
        <ImageView
            android:id="@+id/live_notification_wordmark"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:src="@drawable/live_notification_wordmark"
            android:adjustViewBounds="true"
            android:contentDescription="Matiks"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:id="@+id/live_notification_eyebrow"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/live_notification_streak_row"
            android:paddingTop="6dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/live_notification_streak_flame"
                android:importantForAccessibility="no"/>
            <ImageView
                android:id="@+id/live_notification_streak_image"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:layout_marginStart="5dp"/>
            <TextView
                android:textSize="24sp"
                android:textColor="#cfcedc"
                android:id="@+id/live_notification_streak_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:fontFamily="@font/bebas_neue_bold"
                android:layout_marginStart="5dp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/live_notification_title_image"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"/>
        <TextView
            android:textSize="18sp"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:id="@+id/live_notification_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:fontFamily="@font/nunito_sans_bold"/>
        <LinearLayout
            android:gravity="top"
            android:orientation="horizontal"
            android:id="@+id/live_notification_timer_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <Chronometer
                android:textSize="33sp"
                android:textColor="#ffffff"
                android:id="@+id/live_notification_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:fontFamily="@font/bebas_neue_bold"
                android:letterSpacing="-0.03"
                android:countDown="true"/>
            <ImageView
                android:id="@+id/live_notification_badge"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/live_notification_badge"
                android:importantForAccessibility="no"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
