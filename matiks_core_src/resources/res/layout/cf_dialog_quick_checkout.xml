<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/cf_bg_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="?attr/textAppearanceHeadline5"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_quick_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/checkout"/>
    <TextView
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_quick_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/cf_select_used_payment_mode"
        android:alpha="0.7"/>
    <View
        android:id="@+id/view"
        android:background="@color/cf_black"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="32dp"
        android:layout_marginHorizontal="32dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_quick_checkout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"/>
    <TextView
        android:textColor="@color/color_cta"
        android:id="@+id/tv_show_others"
        android:padding="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/cf_show_other_payment_modes"
        android:layout_marginStart="16dp"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_pay"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="16dp"
        android:text="@string/cf_pay"
        android:textAllCaps="false"
        android:layout_marginHorizontal="32dp"
        android:layout_marginVertical="16dp"/>
</androidx.appcompat.widget.LinearLayoutCompat>
