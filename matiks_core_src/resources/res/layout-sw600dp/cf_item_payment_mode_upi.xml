<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">
    <RelativeLayout
        android:id="@+id/rl_upi_payment_mode"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:id="@+id/view_upi_ic"
            android:background="@drawable/cf_ic_rounded_bg"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_marginHorizontal="16dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_upi_ic"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:src="0x7f0801da"
                android:layout_marginHorizontal="16dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <TextView
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:textSize="18sp"
            android:id="@+id/tv_upi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:text="@string/cf_title_upi"
            android:layout_centerVertical="true"
            android:textAllCaps="true"
            android:layout_toEndOf="@+id/view_upi_ic"
            android:layout_marginHorizontal="16dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_upi_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:src="0x7f0801ce"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:layout_marginHorizontal="16dp"/>
    </RelativeLayout>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/ll_upi_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.card.MaterialCardView
            android:layout_gravity="center_horizontal"
            android:id="@+id/mcv_qr"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardElevation="4dp">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_qr"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="0x7f0801d4"/>
                <TextView
                    android:textSize="16sp"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_qr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cf_qr_des"
                    android:layout_marginStart="16dp"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </com.google.android.material.card.MaterialCardView>
        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/gl_cf_upi_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginHorizontal="16dp"
            app:columnCount="3"
            app:rowCount="2"
            app:useDefaultMargins="true"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/cf_black"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_or"
            android:padding="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_dimen_8"
            android:layout_marginBottom="@dimen/cf_dimen_8"
            android:text="Or"/>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/upi_collect_card"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cf_dimen_32"
            android:layout_marginRight="@dimen/cf_dimen_32"
            android:layout_marginBottom="@dimen/cf_dimen_16"
            android:minHeight="@dimen/cf_dimen_54"
            android:layout_marginHorizontal="@dimen/cf_dimen_32"
            app:cardCornerRadius="@dimen/cf_dimen_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/cf_card_corner_stroke"
            app:strokeWidth="1dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/cf_dimen_16">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/collect_upi_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/collect_upi_header_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pay_with_upi_id"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_upi_arrow_collect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="0x7f0801ce"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/collect_upi_body"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cf_dimen_12"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/collect_upi_header">
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_upi_vpa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:endIconMode="clear_text"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
                        <com.google.android.material.textfield.TextInputEditText
                            android:textSize="12dp"
                            android:id="@+id/tie_upi_vpa"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/cf_upi_hint"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:imeOptions="actionDone"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:textSize="12sp"
                        android:id="@+id/cb_upi_save"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/cf_save_upi_id"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/til_upi_vpa"/>
                    <com.google.android.material.button.MaterialButton
                        android:enabled="false"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/btn_upi"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="@dimen/cf_dimen_12"
                        android:layout_marginBottom="@dimen/cf_dimen_12"
                        android:text="@string/cf_pay"
                        android:textAllCaps="false"
                        android:layout_marginVertical="@dimen/cf_dimen_12"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/cb_upi_save"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
